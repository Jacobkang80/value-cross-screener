.multiple{border-left:1px solid var(--line);padding-left:12px}.multiple .metric-value{color:var(--accent);font-size:26px}.vix-value{font-size:30px;font-weight:700;line-height:1.1;letter-spacing:-.8px}.vix-date{font-size:10px;color:var(--muted);margin-top:5px}\n.reference{font-size:10px;color:#697983;margin:7px 2px 13px;line-height:1.4}.reference a{color:#526974;text-decoration:underline;text-underline-offset:2px}.reference strong{font-weight:600;color:#435c69}\n.toolbar{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:9px}.tabs{display:flex;padding:3px;background:#e8edf0;border-radius:8px;gap:3px}.tabs button{border:0;background:transparent;border-radius:6px;padding:7px 15px;font-size:12px;color:#5f717d}.tabs button[aria-pressed=\"true\"]{background:#fff;color:var(--ink);font-weight:700;box-shadow:0 1px 4px #182c3812}.note{font-size:11px;color:var(--muted)}\n.status{display:flex;align-items:center;gap:6px;font-size:10px;color:var(--muted);white-space:nowrap}.dot{width:5px;height:5px;border-radius:50%;background:var(--accent)}.status.error{color:#a44732}.status.error .dot{background:#b95840}\n.markets{display:grid;grid-template-columns:1fr 1fr;gap:10px}.market{background:white;border:1px solid var(--line);border-radius:10px;overflow:hidden}.market-head{padding:12px 14px 9px;display:flex;justify-content:space-between;align-items:center;border-bottom:1px solid var(--line)}.market-head h2{margin:0;font-size:15px;letter-spacing:.2px}.market-head span{font-size:10px;color:var(--muted)}table{width:100%;border-collapse:collapse;table-layout:fixed}col.rank-col{width:28px}col.price-col{width:76px}col.metric-col{width:57px}th,td{text-align:right;padding:9px 8px;border-bottom:1px solid #edf1f3;font-size:11px}th{font-weight:500;color:var(--muted);background:#fafbfc;font-size:10px;padding-top:7px;padding-bottom:7px}th.company,td.company{text-align:left}th.rank,td.rank{text-align:center;padding-left:7px;padding-right:2px;color:#92a0a8}td.rank{font-weight:600;font-size:11px}tbody tr:last-child td{border-bottom:0}.company a{color:var(--ink);text-decoration:none;font-size:12px;font-weight:600;display:block;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.company a:hover{color:var(--accent)}.code{font-size:9px;color:#90a0aa;display:block;margin-top:1px;letter-spacing:.35px}td.focus,th.focus{color:var(--accent);background:#f0f8f6;font-weight:700}td.price{font-weight:600;font-size:11px}.empty{padding:24px 14px;color:var(--muted);font-size:12px}.empty.error{color:#a44732}.skeleton{height:260px;background:linear-gradient(110deg,#fff 10%,#f6f8fa 45%,#fff 80%);padding:20px;color:#8d9da6;font-size:12px}\n.summary{display:flex;gap:8px;align-items:flex-start;background:#eaf1f2;border:1px solid #dfe8eb;border-radius:7px;padding:9px 12px;margin-top:10px;font-size:11px;line-height:1.5}.summary-label{font-size:10px;font-weight:700;color:#48626f;white-space:nowrap;margin-top:1px}.summary-text{display:flex;flex-wrap:wrap;gap:2px 18px;color:#47616d}\nfooter{display:flex;align-items:flex-start;justify-content:space-between;gap:16px;margin:11px 2px 0;font-size:10px;color:#83919a}footer details{max-width:760px}footer summary{cursor:pointer;color:#687c88}footer p{margin:6px 0;line-height:1.5}.storage{white-space:nowrap;color:#83919a}.loading .dot{animation:pulse 1s infinite}@keyframes pulse{50%{opacity:.25}}\n@media(max-width:900px){main{padding:18px 16px}.markets{grid-template-columns:1fr}col.price-col{width:100px}col.metric-col{width:85px}.company a{font-size:13px}th,td{padding-top:8px;padding-bottom:8px}.note{display:none}}\n@media(max-width:520px){main{padding:14px 10px}.brand h1{font-size:19px}.mark{width:27px;height:27px}.sub{font-size:9px}.bench{grid-template-columns:1fr 1fr;gap:7px}.tile{padding:11px 11px 10px}.tile-head{margin-bottom:7px}.tile-head b{font-size:12px}.tag{font-size:8px;padding:2px 3px}.metrics{gap:4px;grid-template-columns:.7fr .7fr 1fr}.metric-value{font-size:17px}.multiple{padding-left:7px}.multiple .metric-value{font-size:21px}.metric-label{font-size:9px}.vix-tile{grid-column:1/-1;display:flex;align-items:center;justify-content:space-between;gap:12px;padding:9px 12px}.vix-tile .tile-head{margin:0;gap:8px}.vix-value{font-size:24px}.vix-date{margin:0;font-size:9px}.reference{font-size:9px;margin-bottom:11px}.toolbar{gap:6px}.tabs button{padding:7px 11px}.status{font-size:9px}.market-head{padding:10px 11px 8px}col.rank-col{width:23px}col.price-col{width:64px}col.metric-col{width:48px}th,td{padding:8px 5px;font-size:10px}.company a{font-size:11px}.code{font-size:8px}td.price{font-size:10px}.summary{padding:8px 10px;gap:7px;font-size:10px}.summary-text{display:block}.summary-text span{display:block}footer{display:block}.storage{margin-top:6px}}\n.vix-note{display:block;margin-top:3px;font-size:9px;line-height:1.35;color:#8a725a}\n</style></head><body>\n<main>\n<header><div class=\"brand\"><div class=\"mark\" aria-hidden=\"true\"><svg width=\"19\" height=\"19\" viewBox=\"0 0 24 24\" fill=\"none\"><path d=\"M4 17V12M10 17V8M16 17V4M4 21H21\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\"/></svg></div><div><h1>종목 스크리너</h1><div class=\"sub\">KOSPI · KOSDAQ</div></div></div><button class=\"refresh\" id=\"refresh\"><svg viewBox=\"0 0 16 16\" fill=\"none\" aria-hidden=\"true\"><path d=\"M13 6A5.3 5.3 0 1 0 13 10M13 2V6H9\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>갱신 확인</button></header>\n<div id=\"bench\" class=\"bench\" aria-label=\"시장 지표\"></div>\n<div class=\"reference\"><strong>S&amp;P 500 참고 멀티플 141.07</strong> = PER 27.88 × PBR 5.06 · 2025.06.30 기준 · <a href=\"https://topforeignstocks.com/wp-content/uploads/2026/01/SP-500-Factsheet-Dec-31-2025.pdf#page=3\" target=\"_blank\" rel=\"noopener noreferrer\">S&amp;P DJI 자료</a> · 연평균 아님</div>\n<div class=\"toolbar\"><div class=\"tabs\" role=\"group\" aria-label=\"종목 정렬\"><button data-metric=\"pbr\" aria-pressed=\"true\">저PBR</button><button data-metric=\"per\" aria-pressed=\"false\">저PER</button><button data-metric=\"roe\" aria-pressed=\"false\">고ROE</button></div><span class=\"note\">시장별 상위 5개</span><div id=\"status\" class=\"status loading\" role=\"status\" aria-live=\"polite\"><i class=\"dot\"></i><span id=\"status-text\">수집 중</span></div></div>\n<div id=\"results\" class=\"markets\"></div>\n<div class=\"summary\"><span class=\"summary-label\">요약</span><div id=\"summary\" class=\"summary-text\">선택한 지표의 상위 종목을 수집합니다.</div></div>\n<footer><details><summary>수집·계산 기준</summary><p>거래 가능한 보통주 중 선택한 정렬 지표가 양수인 종목을 대상으로 시장별 상위 5개를 표시합니다. 동률이면 종목코드 순입니다. PER·PBR·ROE는 네이버 제공값이며 정확한 결산기간은 미제공입니다. 현재가는 공급자 시세로 지연될 수 있습니다.</p><p>시장 PER·PBR은 KRX 공식 지수값이 아닌 보통주 합산 참고값입니다. 양수 지표별 Σ시가총액 ÷ Σ(시가총액/지표)로 계산합니다. S&amp;P 500은 2025.12.31 발행 팩트시트에 수록된 2025.06.30 기준 후행 PER·PBR을 사용했으며, 멀티플은 두 수치를 곱해 계산했습니다. 시장별 집계 방식과 시점이 달라 직접적인 적정가 비교값은 아닙니다.</p><p>페이지를 열 때 수집하고, 화면이 보이는 동안 10분마다 갱신합니다. 서버 캐시는 10분입니다. AI·유료 API 호출과 일봉 조회는 없습니다. 장애 시 마지막 저장본과 오류를 표시합니다.</p></details><div class=\"storage\" id=\"storage\">Google Sheets 자동 저장</div></footer>\n</main><script>\nvar metric='pbr',data=null,seq=0,busy=false;\nvar labels={pbr:'PBR 낮은 순',per:'PER 낮은 순',roe:'ROE 높은 순'};\nfunction el(id){return document.getElementById(id)}\nfunction esc(v){return String(v==null?'':v).replace(/[&<>\"']/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;',\"'\":'&#39;'}[c]})}\nfunction fmt(v,d){return typeof v==='number'&&isFinite(v)?v.toLocaleString('ko-KR',{maximumFractionDigits:d===undefined?2:d}):'—'}\nfunction time(v){if(!v)return '—';var d=new Date(v);return isNaN(d.getTime())?'—':new Intl.DateTimeFormat('ko-KR',{timeZone:'Asia/Seoul',month:'2-digit',day:'2-digit',hour:'2-digit',minute:'2-digit',hour12:false}).format(d)}\nfunction status(text,error,loading){el('status').className='status'+(error?' error':'')+(loading?' loading':'');el('status-text').textContent=text}\nfunction skeleton(){el('results').innerHTML=['KOSPI','KOSDAQ'].map(function(m){return '<section class=\"market\"><div class=\"market-head\"><h2>'+m+'</h2><span>TOP 5</span></div><div class=\"skeleton\">순위를 수집하고 있습니다.</div></section>'}).join('')}\nfunction render(){\n el('bench').innerHTML=['KOSPI','KOSDAQ'].map(function(market){\n var m=data.markets.filter(function(x){return x.market===market})[0];\n if(!m)return '<article class=\"tile\"><div class=\"tile-head\"><b>'+market+'</b><span class=\"tag\">보통주 합산</span></div><div class=\"empty error\">지표 수집 실패</div></article>';\n var multiple=typeof m.per==='number'&&typeof m.pbr==='number'?m.per*m.pbr:null;\n return '<article class=\"tile\"><div class=\"tile-head\"><b>'+m.market+'</b><span class=\"tag\">보통주 합산 · 참고값</span></div><div class=\"metrics\"><div><div class=\"metric-label\">PER</div><div class=\"metric-value\">'+fmt(m.per)+'</div></div><div><div class=\"metric-label\">PBR</div><div class=\"metric-value\">'+fmt(m.pbr)+'</div></div><div class=\"multiple\"><div class=\"metric-label\">멀티플 PER × PBR</div><div class=\"metric-value\">'+fmt(multiple)+'</div></div></div></article>'\n }).join('')+'<article class=\"tile vix-tile\"><div class=\"tile-head\"><b>VIX</b><span class=\"tag\">Cboe</span></div><div class=\"vix-value\">'+fmt(data.vix.value)+'</div><div class=\"vix-date\">'+(data.vix.status==='ok'?'미국 '+esc(data.vix.asOf)+' 종가':'조회 실패 · '+esc(data.vix.error||''))+'<span class=\"vix-note\" title=\"VIX는 S&P 500의 예상 변동성 지표입니다. 14 미만 과열 주의는 사용자가 정한 참고 기준입니다.\">14 미만: 과열 주의 · 참고 기준</span></div></article>';\n el('results').innerHTML=['KOSPI','KOSDAQ'].map(function(m){\n var a=data.stocks.filter(function(s){return s.market===m}),error=data.errors.filter(function(e){return e.market===m})[0];\n var header='<div class=\"market-head\"><h2>'+m+'</h2><span>'+labels[metric]+' · TOP '+a.length+'</span></div>';\n if(error)return '<section class=\"market\">'+header+'<div class=\"empty error\">'+esc(error.error)+'</div></section>';\n if(!a.length)return '<section class=\"market\">'+header+'<div class=\"empty\">해당 없음 · 선택 지표가 양수인 종목이 없습니다.</div></section>';\n var columns=['pbr','per','roe'];\n return '<section class=\"market\">'+header+'<table aria-label=\"'+m+' '+labels[metric]+' 상위 5개\"><colgroup><col class=\"rank-col\"><col><col class=\"price-col\"><col class=\"metric-col\"><col class=\"metric-col\"><col class=\"metric-col\"></colgroup><thead><tr><th class=\"rank\" scope=\"col\">#</th><th class=\"company\" scope=\"col\">종목</th><th scope=\"col\">현재가</th>'+columns.map(function(k){return '<th scope=\"col\" class=\"'+(k===metric?'focus':'')+'\">'+k.toUpperCase()+(k==='roe'?' %':'')+'</th>'}).join('')+'</tr></thead><tbody>'+a.map(function(s){return '<tr><td class=\"rank\">'+s.valueRank+'</td><td class=\"company\"><a href=\"https://stock.naver.com/domestic/stock/'+s.code+'\" title=\"'+esc(s.name)+'\" target=\"_blank\" rel=\"noopener noreferrer\">'+esc(s.name)+'</a><span class=\"code\">'+s.code+'</span></td><td class=\"price\">'+fmt(s.valuationPrice,0)+'</td>'+columns.map(function(k){return '<td class=\"'+(k===metric?'focus':'')+'\">'+fmt(s[k],k==='pbr'?3:2)+'</td>'}).join('')+'</tr>'}).join('')+'</tbody></table></section>'\n }).join('');\n el('summary').innerHTML=data.summary.map(function(s){return '<span>'+esc(s)+'</span>'}).join('');\n status(data.stale?'저장본 · 갱신 실패':'수집 '+time(data.collectedAt),data.stale||data.status!=='complete',false);\n el('status').title=data.refreshError||data.errors.map(function(e){return e.market+': '+e.error}).join(' / ');\n el('storage').textContent='Sheets 저장 '+time(data.savedAt)+' · 10분 자동 갱신';\n}\nfunction load(){\n if(busy)return;\n busy=true;var id=++seq;\n el('refresh').disabled=true;document.querySelectorAll('[data-metric]').forEach(function(b){b.disabled=true});\n status('수집·저장 중',false,true);\n google.script.run.withSuccessHandler(function(d){\n if(id!==seq)return;data=d;busy=false;el('refresh').disabled=false;document.querySelectorAll('[data-metric]').forEach(function(b){b.disabled=false});render();\n }).withFailureHandler(function(e){\n if(id!==seq)return;busy=false;el('refresh').disabled=false;document.querySelectorAll('[data-metric]').forEach(function(b){b.disabled=false});\n status('조회 실패',true,false);el('summary').textContent=e.message+(data?' · 기존 결과 유지':'');\n if(!data)el('results').innerHTML='<div class=\"empty error\">자료를 불러오지 못했습니다. 갱신 확인을 눌러 다시 조회해 주세요.</div>';\n }).getDashboard(metric);\n}\ndocument.querySelectorAll('[data-metric]').forEach(function(b){b.onclick=function(){\n if(busy||metric===b.dataset.metric)return;metric=b.dataset.metric;data=null;skeleton();el('summary').textContent='선택한 지표의 순위를 확인합니다.';\n document.querySelectorAll('[data-metric]').forEach(function(x){x.setAttribute('aria-pressed',String(x===b))});load();\n}});\nel('refresh').onclick=load;\nsetInterval(function(){if(!document.hidden&&!busy)load()},600000);\nskeleton();load();\n</script></body></html>\n";}
