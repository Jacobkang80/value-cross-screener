/** Value Cross: no AI API, no paid data API. */
var VC_BOOK_ID = 'YOUR_SPREADSHEET_ID';
var VC_MARKETS = ['KOSPI','KOSDAQ'];
function setup(){
 PropertiesService.getScriptProperties().setProperty('SPREADSHEET_ID',VC_BOOK_ID);
 CacheService.getScriptCache().removeAll(['dashboard:pbr','dashboard:per','dashboard:roe']);
 var d=getDashboard('pbr');
 Logger.log(JSON.stringify({asOf:d.asOf,status:d.status,stocks:d.stocks.length,savedAt:d.savedAt,summary:d.summary}));
 return d;
}
function doGet(){return HtmlService.createHtmlOutput(page_()).setTitle('종목 스크리너').addMetaTag('viewport','width=device-width,initial-scale=1');}
function book_(){var id=PropertiesService.getScriptProperties().getProperty('SPREADSHEET_ID');if(!id)throw Error('먼저 setup 함수를 실행하세요.');return SpreadsheetApp.openById(id);}
function number_(x){if(x===null||x===undefined||String(x).trim()==='')return null;var n=Number(String(x).replace(/,/g,'').replace('%',''));return isFinite(n)?n:null;}
function sma_(a,n,end){end=end===undefined?a.length-1:end;if(end<n-1)return null;var sum=0;for(var i=end-n+1;i<=end;i++){if(!(a[i]>0))return null;sum+=a[i];}return sum/n;}
function rank_(a,metric){return a.filter(function(s){return s.pbr>0&&s.per>0&&s.roe>0;}).sort(function(a,b){return (metric==='roe'?-1:1)*(a[metric]-b[metric])||a.pbr-b.pbr||a.per-b.per||b.roe-a.roe||a.code.localeCompare(b.code);}).slice(0,10).map(function(s,i){s.valueRank=i+1;return s;});}
function date_(rows){var now=new Date(),today=Utilities.formatDate(now,'Asia/Seoul','yyyy-MM-dd'),settled=Number(Utilities.formatDate(now,'Asia/Seoul','HHmm'))>=1630;var dates=rows.map(function(r){return String(r.localTradedAt||'').slice(0,10);}).filter(function(d){return /^\d{4}-\d{2}-\d{2}$/.test(d)&&(settled?d<=today:d<today);}).sort();if(!dates.length)throw Error('완료 거래일 확인 실패');return dates[dates.length-1];}
function text_(r){var code=r.getResponseCode();if(code!==200)throw Error('공급자 HTTP '+code);return r.getContentText();}
function options_(url){return {url:url,muteHttpExceptions:true,followRedirects:true,headers:{Referer:'https://stock.naver.com/'}};}
function aggregate_(rows,market){var out={market:market,basis:'보통주 합산 참고값',officialIndex:false};['per','pbr'].forEach(function(k){var a=rows.filter(function(s){return number_(s[k])>0&&number_(s.marketSum)>0;}),cap=0,den=0;a.forEach(function(s){cap+=number_(s.marketSum);den+=number_(s.marketSum)/number_(s[k]);});out[k]=den>0?cap/den:null;out[k+'Count']=a.length;});return out;}
function parseBars_(xml,asOf){var byDate={},rx=/<item\s+data="([^"]+)"/g,match;while((match=rx.exec(xml))!==null){var a=match[1].split('|'),s=a[0];if(!/^\d{8}$/.test(s))continue;var date=s.slice(0,4)+'-'+s.slice(4,6)+'-'+s.slice(6,8),close=number_(a[4]);if(date<=asOf&&close>0)byDate[date]={date:date,close:close,volume:number_(a[5])};}var rows=Object.keys(byDate).sort().map(function(d){return byDate[d];});if(rows.length<81)throw Error('일봉 부족: '+rows.length+'/81');if(rows[rows.length-1].date!==asOf)throw Error('최신 일봉 없음: '+rows[rows.length-1].date);return rows;}
function applyBars_(s,rows){var p=rows.map(function(r){return r.close;});s.prices=p;s.dates=rows.map(function(r){return r.date;});s.volumes=rows.map(function(r){return r.volume;});s.ma5=sma_(p,5);s.ma80=sma_(p,80);s.prev5=sma_(p,5,p.length-2);s.prev80=sma_(p,80,p.length-2);s.crossToday=s.ma5>s.ma80&&s.prev5<=s.prev80;s.priceStatus='ok';return s;}
function vix_(r){var out={value:null,status:'error',source:'https://cdn.cboe.com/api/global/us_indices/daily_prices/VIX_History.csv'};try{var lines=text_(r).trim().split(/\r?\n/),today=Utilities.formatDate(new Date(),'America/New_York','yyyy-MM-dd');for(var i=lines.length-1;i>0;i--){var a=lines[i].split(','),m=a[0].match(/^(\d{1,2})\/(\d{1,2})\/(\d{4})$/);if(!m)continue;var date=m[3]+'-'+('0'+m[1]).slice(-2)+'-'+('0'+m[2]).slice(-2);if(date<=today&&number_(a[4])>0){out.value=number_(a[4]);out.asOf=date;out.status='ok';break;}}if(!out.value)throw Error('VIX 종가 없음');}catch(e){out.error=e.message;}return out;}
function collect_(metric){
 var urls=VC_MARKETS.map(function(m){return 'https://stock.naver.com/api/domestic/market/stock/default?tradeType=KRX&marketType='+m+'&orderType=marketSum&startIdx=0&pageSize=5000';});urls.push('https://m.stock.naver.com/api/index/KOSPI/price?pageSize=5&page=1');urls.push('https://cdn.cboe.com/api/global/us_indices/daily_prices/VIX_History.csv');
 var raw=UrlFetchApp.fetchAll(urls.map(options_)),asOf=date_(JSON.parse(text_(raw[2]))),d={schemaVersion:4,mode:'collected',rankMetric:metric,candidateLimit:10,asOf:asOf,collectedAt:new Date().toISOString(),markets:[],stocks:[],counts:{},errors:[],vix:vix_(raw[3]),officialMarkets:[],officialStatus:'unavailable'};
 VC_MARKETS.forEach(function(m,i){try{var rows=JSON.parse(text_(raw[i]));if(!Array.isArray(rows)||rows.length<500||rows.length>=5000)throw Error('시장 목록 불완전');var ordinary=rows.filter(function(s){return s.type==='ST'&&/^[0-9]{5}0$/.test(s.itemcode||'')&&!/스팩/.test(s.itemname||'');});var valid=ordinary.filter(function(s){return s.tradeStopYn==='N'&&number_(s.pbr)>0&&number_(s.per)>0&&number_(s.roe)>0;}).map(function(s){return {code:s.itemcode,name:s.itemname,market:m,pbr:number_(s.pbr),per:number_(s.per),roe:number_(s.roe),valuationPrice:number_(s.nowPrice),fundamentalPeriod:'네이버 제공값 · 정확한 결산기간 미제공',asOf:asOf,source:urls[i]};});d.counts[m]={listed:rows.length,valid:valid.length,candidates:Math.min(valid.length,10)};d.markets.push(aggregate_(ordinary,m));d.stocks=d.stocks.concat(rank_(valid,metric));}catch(e){d.errors.push({market:m,error:e.message});}});
 if(!d.stocks.length&&d.errors.length)throw Error(d.errors.map(function(e){return e.market+': '+e.error;}).join(' / '));
 var cache=CacheService.getScriptCache(),missing=[];
 d.stocks.forEach(function(s){s.priceSource='https://fchart.stock.naver.com/sise.nhn?symbol='+s.code+'&timeframe=day&count=100&requestType=0';var key='bars:'+s.code+':'+asOf,saved=cache.get(key);try{if(saved)applyBars_(s,JSON.parse(saved));else missing.push({s:s,key:key});}catch(e){missing.push({s:s,key:key});}});
 if(missing.length){var charts;try{charts=UrlFetchApp.fetchAll(missing.map(function(x){return options_(x.s.priceSource);}));}catch(e){missing.forEach(function(x){x.s.priceStatus='error';x.s.priceError=e.message;x.s.prices=[];});}if(charts)missing.forEach(function(x,i){try{var rows=parseBars_(text_(charts[i]),asOf);applyBars_(x.s,rows);cache.put(x.key,JSON.stringify(rows),21600);}catch(e){x.s.priceStatus=e.message.indexOf('일봉 부족')===0?'insufficient':'error';x.s.priceError=e.message;x.s.prices=[];}});}
 var ok=d.stocks.filter(function(s){return s.priceStatus==='ok';}).length,hits=d.stocks.filter(function(s){return s.crossToday;});d.status=d.errors.length||ok<d.stocks.length?'partial':'complete';d.summary=['일봉 기준일 '+asOf+' · '+(metric==='pbr'?'저PBR':metric==='per'?'저PER':'고ROE')+' 시장별 상위 10개를 선정했습니다.','후보 '+d.stocks.length+'개 중 '+ok+'개 확인 · 상향 돌파 '+hits.length+'개'+(hits.length?': '+hits.map(function(s){return s.name;}).join(', '):'')+'.',d.errors.length||ok<d.stocks.length?'미확인 후보가 있어 돌파 종목이 없다고 확정할 수 없습니다.':'모든 후보를 확인했습니다. 조건 충족 종목이 없으면 없음으로 표시합니다.','VIX '+(d.vix.status==='ok'?d.vix.value+' · 미국 '+d.vix.asOf:'조회 실패')+' / PER·PBR은 공식 지수와 구분한 합산 참고값입니다.'];return d;
}
function sheet_(name,headers){var b=book_(),s=b.getSheetByName(name);if(!s){s=b.insertSheet(name);s.getRange(1,1,1,headers.length).setValues([headers]).setBackground('#e4ecde').setFontWeight('bold');s.setFrozenRows(1);}return s;}
function safe_(v){return typeof v==='string'&&/^[=+@]/.test(v)?"'"+v:v===undefined||v===null?'':v;}
function normalizedRow_(r,headers){return r.map(function(v,i){if(headers[i]==='코드')return ('000000'+String(v)).slice(-6);if(/기준일$/.test(headers[i])&&Object.prototype.toString.call(v)==='[object Date]')return Utilities.formatDate(v,'Asia/Seoul','yyyy-MM-dd');return v;});}
function upsert_(name,headers,incoming,keyCols){var s=sheet_(name,headers),count=Math.max(0,s.getLastRow()-1),old=count?s.getRange(2,1,count,headers.length).getValues():[],rows=[],index={};old.concat(incoming).forEach(function(r){r=normalizedRow_(r,headers);var key=keyCols.map(function(k){return r[k];}).join('|');if(index[key]!==undefined)rows[index[key]]=r;else{index[key]=rows.length;rows.push(r);}});if(rows.length){headers.forEach(function(h,i){if(h==='코드'||/기준일$/.test(h))s.getRange(2,i+1,Math.max(count,rows.length),1).setNumberFormat('@');});s.getRange(2,1,rows.length,headers.length).setValues(rows.map(function(r){return r.map(safe_);}));}if(count>rows.length)s.getRange(rows.length+2,1,count-rows.length,headers.length).clearContent();return s;}
function save_(d){d.savedAt=new Date().toISOString();var rows=d.stocks.map(function(s){return [d.asOf,d.rankMetric,s.code,s.name,s.market,s.valueRank,s.pbr,s.per,s.roe,s.priceStatus,s.crossToday===true,s.ma5,s.ma80,s.prev5,s.prev80,d.collectedAt,s.priceError||''];});upsert_('VC_후보',['일봉기준일','정렬','코드','종목명','시장','가치순위','PBR','PER','ROE','일봉상태','당일돌파','SMA5','SMA80','전일SMA5','전일SMA80','수집시각','오류'],rows,[0,1,2]);upsert_('VC_시장',['일봉기준일','정렬','시장','PER','PBR','PERxPBR','VIX','VIX미국기준일','계산기준','수집시각'],d.markets.map(function(m){return [d.asOf,d.rankMetric,m.market,m.per,m.pbr,m.per*m.pbr,d.vix.value,d.vix.asOf||'',m.basis,d.collectedAt];}),[0,1,2]);upsert_('VC_일봉',['기준일','코드','시장','일봉JSON','출처','수집시각'],d.stocks.filter(function(s){return s.priceStatus==='ok';}).map(function(s){return [d.asOf,s.code,s.market,JSON.stringify(s.prices.map(function(close,i){return {date:s.dates[i],close:close,volume:s.volumes[i]};})),s.priceSource,d.collectedAt];}),[0,1]);var json=JSON.stringify(d),parts=[];for(var n=0;n<json.length;n+=40000)parts.push([d.rankMetric,d.savedAt,n/40000,json.slice(n,n+40000)]);var snap=sheet_('VC_스냅샷',['정렬','저장시각','조각','JSON']),keep=snap.getLastRow()>1?snap.getRange(2,1,snap.getLastRow()-1,4).getValues().filter(function(r){return r[0]!==d.rankMetric;}):[];if(snap.getLastRow()>1)snap.getRange(2,1,snap.getLastRow()-1,4).clearContent();snap.getRange(2,1,keep.length+parts.length,4).setValues(keep.concat(parts));var log=sheet_('VC_로그',['수집시각','일봉기준일','정렬','상태','규칙기반요약']);log.appendRow([d.collectedAt,d.asOf,d.rankMetric,d.status,d.summary.join('\n')]);SpreadsheetApp.flush();return d;}
function last_(metric){var s=book_().getSheetByName('VC_스냅샷');if(!s||s.getLastRow()<2)return null;var rows=s.getRange(2,1,s.getLastRow()-1,4).getValues().filter(function(r){return r[0]===metric;}).sort(function(a,b){return a[2]-b[2];});return rows.length?JSON.parse(rows.map(function(r){return r[3];}).join('')):null;}
function getDashboard(metric){if(['pbr','per','roe'].indexOf(metric)<0)throw Error('정렬 기준 오류');var cache=CacheService.getScriptCache(),key='dashboard:'+metric,cached=cache.get(key);if(cached)return JSON.parse(cached);var lock=LockService.getScriptLock();if(!lock.tryLock(1000)){var previous=last_(metric);if(previous){previous.stale=true;previous.refreshError='다른 수집이 진행 중입니다.';return previous;}throw Error('다른 수집이 진행 중입니다. 잠시 후 다시 확인하세요.');}try{cached=cache.get(key);if(cached)return JSON.parse(cached);var d=save_(collect_(metric)),text=JSON.stringify(d);if(Utilities.newBlob(text).getBytes().length<95000)cache.put(key,text,d.status==='complete'?600:180);return d;}catch(e){var previous=last_(metric);if(previous){previous.stale=true;previous.refreshError=e.message;return previous;}throw e;}finally{lock.releaseLock();}}

function page_(){return "<!doctype html><html lang=\"ko\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>종목 스크리너</title><style>*{box-sizing:border-box}body{margin:0;background:#f4f6f1;color:#20382c;font:15px Arial,'Malgun Gothic',sans-serif}main{max-width:1150px;margin:auto;padding:24px}header,.row{display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap}h1{font-size:25px;margin:0}h2{font-size:19px}button{padding:10px 16px;background:white;border:1px solid #cbd6c6;border-radius:7px;cursor:pointer;color:#20382c}.active{background:#244f39;color:white}.grid{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;margin:20px 0}.panel,.stock{background:white;border:1px solid #dce3d6;border-radius:11px;padding:20px}.value{font-size:28px;font-weight:bold}.label,.small{font-size:12px;color:#647467;line-height:1.7}.status{background:#e6eddf;border-radius:7px;padding:12px;margin:14px 0;line-height:1.7}.summary{line-height:1.9;margin:0;padding-left:22px}.tabs{display:flex;gap:8px;margin:20px 0}.market{margin:20px 0}.cards{display:grid;grid-template-columns:repeat(3,1fr);gap:12px}.empty{padding:20px;background:white;border:1px solid #dce3d6;border-radius:10px}.error{color:#a34e36}.stats{display:flex;justify-content:space-between;gap:15px;margin:16px 0}a{color:#2b6044}svg{width:100%;height:90px}table{width:100%;font-size:12px;border-collapse:collapse}td{padding:7px;border-bottom:1px solid #e4e8e0}button:disabled{opacity:.5;cursor:wait}@media(max-width:650px){main{padding:16px}.grid,.cards{grid-template-columns:1fr}.value{font-size:26px}}</style></head><body><main><header><h1>종목 스크리너</h1><button id=\"refresh\">갱신 확인</button></header><p class=\"small\">Google Apps Script · AI 호출 없음 · 유료 API 없음</p><div id=\"status\" class=\"status\">최신 정보 수집 중입니다.</div><div id=\"bench\" class=\"grid\"></div><section class=\"panel\"><h2>자동 요약</h2><ul id=\"summary\" class=\"summary\"><li>수집 후 표시됩니다.</li></ul></section><div class=\"tabs\"><button data-metric=\"pbr\" class=\"active\">저PBR</button><button data-metric=\"per\">저PER</button><button data-metric=\"roe\">고ROE</button></div><div class=\"small\">각 시장의 가치지표 상위 10개만 일봉을 확인합니다. 전일 SMA5 ≤ SMA80, 최신 완료 거래일 SMA5 &gt; SMA80.</div><div id=\"results\"></div><section class=\"panel\"><h2>운영 기준</h2><p class=\"small\">열 때 자동 수집하며, 열린 동안 10분마다 갱신합니다. 서버 결과는 10분 동안 재사용합니다. 장중에도 이평선 판정은 완료된 일봉을 사용하며 한국시간 16:30 전에는 당일 일봉을 제외합니다. PER·PBR·ROE는 공급자 제공값이며 ROE의 정확한 결산기간은 미제공입니다. KRX 공식 지수 PER·PBR을 확보하지 못한 경우 보통주 합산 참고값을 명시합니다. 수정주가는 공급자 기준입니다. 시세 지연·휴장·외부 공급자 제한이 있을 수 있습니다.</p><p id=\"storage\" class=\"small\"></p></section></main><script>var metric='pbr',data=null,seq=0,busy=false;var labels={pbr:'PBR 낮은 순',per:'PER 낮은 순',roe:'ROE 높은 순'};function el(id){return document.getElementById(id)}function esc(v){return String(v==null?'':v).replace(/[&<>\"']/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;',\"'\":'&#39;'}[c]})}function fmt(v){return typeof v==='number'&&isFinite(v)?v.toLocaleString('ko-KR',{maximumFractionDigits:2}):'미확보'}function chart(s){var a=s.prices||[];if(a.length<81)return '';var values=a.slice(-20),lo=Math.min.apply(null,values)*.99,hi=Math.max.apply(null,values)*1.01;var points=values.map(function(v,i){return (i*400/(values.length-1))+','+(85-(v-lo)/(hi-lo)*75)}).join(' ');return '<svg viewBox=\"0 0 400 90\" role=\"img\" aria-label=\"최근 20일 종가\"><polyline points=\"'+points+'\" fill=\"none\" stroke=\"#3f7554\" stroke-width=\"2\"/></svg>'}function render(){if(!data)return;el('bench').innerHTML=data.markets.map(function(m){return '<article class=\"panel\"><b>'+m.market+'</b><p class=\"small\">보통주 합산 · 참고값</p><div class=\"stats\"><div><span class=\"label\">PER</span><div class=\"value\">'+fmt(m.per)+'</div></div><div><span class=\"label\">PBR</span><div class=\"value\">'+fmt(m.pbr)+'</div></div></div><p>멀티플 PER × PBR <b>'+fmt(m.per*m.pbr)+'</b></p><p class=\"small\">KRX 공식 지수값과 다릅니다.<br>양수 지표별 Σ시총 ÷ Σ(시총/지표)<br>PER '+m.perCount+'개 · PBR '+m.pbrCount+'개</p></article>'}).join('')+'<article class=\"panel\"><b>VIX</b><p class=\"small\">Cboe · 미국 종가</p><div class=\"value\">'+fmt(data.vix.value)+'</div><p class=\"small\">미국 기준일 '+esc(data.vix.asOf||'미확보')+'<br>'+esc(data.vix.error||'공급자의 최신 제공 종가')+'</p></article>';el('summary').innerHTML=data.summary.map(function(t){return '<li>'+esc(t)+'</li>'}).join('');el('results').innerHTML=['KOSPI','KOSDAQ'].map(function(m){var a=data.stocks.filter(function(s){return s.market===m}),hits=a.filter(function(s){return s.priceStatus==='ok'&&s.crossToday}),bad=a.filter(function(s){return s.priceStatus!=='ok'}),failed=data.errors.some(function(e){return e.market===m});var cards=hits.slice(0,3).map(function(s){return '<article class=\"stock\"><div class=\"small\">가치순위 '+s.valueRank+' / 10 · '+s.code+'</div><h2><a href=\"https://stock.naver.com/domestic/stock/'+s.code+'\" target=\"_blank\" rel=\"noopener noreferrer\">'+esc(s.name)+'</a></h2><div class=\"value\">'+fmt(s.prices[s.prices.length-1])+'원</div>'+chart(s)+'<div class=\"stats\"><span>PBR '+fmt(s.pbr)+'</span><span>PER '+fmt(s.per)+'</span><span>ROE '+fmt(s.roe)+'%</span></div><details><summary>돌파 계산 근거</summary><table><tr><td>오늘 SMA5 / SMA80</td><td>'+fmt(s.ma5)+' / '+fmt(s.ma80)+'</td></tr><tr><td>전일 SMA5 / SMA80</td><td>'+fmt(s.prev5)+' / '+fmt(s.prev80)+'</td></tr></table></details></article>'}).join('');return '<section class=\"market\"><h2>'+m+' · '+labels[metric]+'</h2><p class=\"small\">후보 '+a.length+'개 · 일봉 확인 '+(a.length-bad.length)+'개 · 돌파 '+hits.length+'개 · 최대 상위 3개 표시</p>'+(hits.length?'<div class=\"cards\">'+cards+'</div>':'<div class=\"empty\"><b>'+(bad.length||failed?'미확인 종목 있음':'없음')+'</b><p class=\"small\">'+(bad.length||failed?'확인한 종목에는 돌파가 없으나 전체 후보의 조건 충족 여부는 확정하지 못했습니다.':'상위 10개 중 최신 완료 거래일에 상향 돌파한 종목이 없습니다.')+'</p></div>')+(bad.length?'<details class=\"small error\"><summary>미확인 '+bad.length+'개</summary>'+bad.map(function(s){return '<p>'+esc(s.name)+' · '+esc(s.priceError)+'</p>'}).join('')+'</details>':'')+'</section>'}).join('');el('storage').textContent='Google Sheets 자동 저장 · 저장 시각 '+(data.savedAt||'저장 확인 전')+' · 결과 '+data.status;el('status').textContent=(data.stale?'갱신 실패로 마지막 저장본 표시 · '+data.refreshError:'실제 수집 결과')+' | 일봉 기준일 '+data.asOf+' | 수집 '+data.collectedAt;}function load(){var id=++seq;busy=true;el('refresh').disabled=true;el('status').textContent='시세 수집·분석·시트 저장 중입니다. 완료 일봉을 확인합니다.';google.script.run.withSuccessHandler(function(d){if(id!==seq)return;data=d;busy=false;el('refresh').disabled=false;render()}).withFailureHandler(function(e){if(id!==seq)return;busy=false;el('refresh').disabled=false;el('status').textContent='조회 실패: '+e.message+(data?' · 기존 결과는 유지합니다.':'')}).getDashboard(metric)}document.querySelectorAll('[data-metric]').forEach(function(b){b.onclick=function(){metric=b.dataset.metric;data=null;el('bench').innerHTML='';el('results').innerHTML='';el('summary').innerHTML='<li>선택한 정렬 기준을 확인 중입니다.</li>';document.querySelectorAll('[data-metric]').forEach(function(x){x.classList.toggle('active',x===b)});load()}});el('refresh').onclick=load;setInterval(function(){if(!document.hidden&&!busy)load()},600000);load();</script></body></html>";}
