/** Screening v6: >= KRW 1tn; positive PER/PBR; ROE top 5; separate reported-quarter turnarounds. */
var VC_BOOK_ID='YOUR_SPREADSHEET_ID';
var VC_MARKETS=['KOSPI','KOSDAQ'];
var VC_LABELS={multiple:'저멀티플',roe:'고ROE'};
var VC_MIN_CAP=1000000000000;
var VC_FINANCE_TTL=21600;
function setup(){
 PropertiesService.getScriptProperties().setProperty('SPREADSHEET_ID',VC_BOOK_ID);
 CacheService.getScriptCache().removeAll(['screen6:pbr','screen6:per','screen6:roe']);
 var d=getDashboard('multiple');
 Logger.log(JSON.stringify({asOf:d.asOf,status:d.status,stocks:d.stocks.length,counts:d.counts,savedAt:d.savedAt}));
 return d;
}
function doGet(){return HtmlService.createHtmlOutput(page_()).setTitle('종목 스크리너').addMetaTag('viewport','width=device-width,initial-scale=1');}
function ordinary_(s){return s.type==='ST'&&/^[0-9]{5}0$/.test(s.itemcode||'')&&!/스팩/.test(s.itemname||'')&&s.tradeStopYn==='N';}
function baseEligible_(s){return s.marketCap>=VC_MIN_CAP&&s.pbr>0&&s.per>0;}
function turnEligible_(s){return s.marketCap>=VC_MIN_CAP&&s.pbr>0;}
function rank_(rows,metric){
 return rows.filter(function(s){return baseEligible_(s)&&(metric==='multiple'||typeof s.roe==='number'&&isFinite(s.roe)&&s.roe>0);}).map(function(s){var o=Object.assign({},s);o.multiple=s.per*s.pbr;return o;}).sort(function(a,b){return (metric==='roe'?b.roe-a.roe:a.multiple-b.multiple)||b.marketCap-a.marketCap||a.code.localeCompare(b.code);}).slice(0,5).map(function(s,i){s.valueRank=i+1;return s;});
}
function collect_(metric){
 var urls=VC_MARKETS.map(function(m){return 'https://stock.naver.com/api/domestic/market/stock/default?tradeType=KRX&marketType='+m+'&orderType=marketSum&startIdx=0&pageSize=5000';});
 urls.push('https://cdn.cboe.com/api/global/us_indices/daily_prices/VIX_History.csv');
 var raw=UrlFetchApp.fetchAll(urls.map(options_));
 var d={schemaVersion:6,mode:'collected',rankMetric:metric,candidateLimit:5,minMarketCap:1000000000000,asOf:Utilities.formatDate(new Date(),'Asia/Seoul','yyyy-MM-dd'),collectedAt:new Date().toISOString(),markets:[],stocks:[],roeStocks:[],universe:[],counts:{},errors:[],vix:vix_(raw[2]),officialStatus:'unavailable'};
 VC_MARKETS.forEach(function(m,i){
  try{
   var rows=JSON.parse(text_(raw[i]));if(!Array.isArray(rows)||rows.length<500||rows.length>=5000)throw Error('시장 목록 불완전');
   var allOrdinary=rows.filter(function(s){return s.type==='ST'&&/^[0-9]{5}0$/.test(s.itemcode||'')&&!/스팩/.test(s.itemname||'');});
   var tradable=rows.filter(ordinary_).map(function(s){return {code:s.itemcode,name:s.itemname,market:m,marketCap:number_(s.marketSum),pbr:number_(s.pbr),per:number_(s.per),roe:number_(s.roe),valuationPrice:number_(s.nowPrice)};});
   var large=tradable.filter(function(s){return s.marketCap>=VC_MIN_CAP;}),base=large.filter(baseEligible_);
   d.counts[m]={listed:rows.length,large:large.length,base:base.length,valid:base.length,turnEligible:large.filter(turnEligible_).length};
   d.markets.push(aggregate_(allOrdinary,m));d.stocks=d.stocks.concat(rank_(large,'multiple'));d.roeStocks=d.roeStocks.concat(rank_(large,'roe'));
  }catch(e){d.errors.push({market:m,error:e.message});}
 });
 if(!d.markets.length&&d.errors.length)throw Error(d.errors.map(function(e){return e.market+': '+e.error;}).join(' / '));
 d.status=d.errors.length||d.vix.status!=='ok'?'partial':'complete';
 d.summary=VC_MARKETS.map(function(m){var a=d.stocks.filter(function(s){return s.market===m;}),c=d.counts[m];return c?m+' 시총 1조↑ '+c.large+'개 → PER·PBR 양수 '+c.base+'개 → '+VC_LABELS[metric]+' '+a.length+'개':m+' 수집 실패';});
 return d;
}
function save_(d){
 d.savedAt=new Date().toISOString();
 upsert_('VC_선별순위',['기준일','정렬','코드','종목명','시장','순위','시가총액_원','PBR','PER','ROE','현재가','수집시각'],d.stocks.map(function(s){return [d.asOf,'multiple',s.code,s.name,s.market,s.valueRank,s.marketCap,s.pbr,s.per,s.roe,s.valuationPrice,d.collectedAt];}).concat(d.roeStocks.map(function(s){return [d.asOf,'roe',s.code,s.name,s.market,s.valueRank,s.marketCap,s.pbr,s.per,s.roe,s.valuationPrice,d.collectedAt];})),[0,1,2]);
 upsert_('VC_시장',['일봉기준일','정렬','시장','PER','PBR','PERxPBR','VIX','VIX미국기준일','계산기준','수집시각'],d.markets.map(function(m){return [d.asOf,d.rankMetric,m.market,m.per,m.pbr,m.per!==null&&m.pbr!==null?m.per*m.pbr:null,d.vix.value,d.vix.asOf||'',m.basis,d.collectedAt];}),[0,1,2]);
 var text=JSON.stringify(d),parts=[];for(var n=0;n<text.length;n+=40000)parts.push([d.rankMetric,d.savedAt,n/40000,text.slice(n,n+40000)]);
 var snap=sheet_('VC_선별스냅샷',['정렬','저장시각','조각','JSON']),keep=snap.getLastRow()>1?snap.getRange(2,1,snap.getLastRow()-1,4).getValues().filter(function(r){return r[0]!==d.rankMetric;}):[];
 if(snap.getLastRow()>1)snap.getRange(2,1,snap.getLastRow()-1,4).clearContent();
 snap.getRange(2,1,keep.length+parts.length,4).setValues(keep.concat(parts));
 sheet_('VC_선별로그',['수집시각','기준일','정렬','상태','규칙기반요약']).appendRow([d.collectedAt,d.asOf,d.rankMetric,d.status,d.summary.join('\n')]);
 SpreadsheetApp.flush();return d;
}
function last_(metric){
 var s=book_().getSheetByName('VC_선별스냅샷');if(!s||s.getLastRow()<2)return null;
 var rows=s.getRange(2,1,s.getLastRow()-1,4).getValues().filter(function(r){return r[0]===metric;}).sort(function(a,b){return a[2]-b[2];});
 return rows.length?JSON.parse(rows.map(function(r){return r[3];}).join('')):null;
}
function publicDashboard_(d){var out=Object.assign({},d);delete out.universe;return out;}
function getDashboard(metric){
 if(['multiple'].indexOf(metric)<0)throw Error('정렬 기준 오류');
 var cache=CacheService.getScriptCache(),key='screen7:'+metric,cached=cache.get(key);if(cached)return JSON.parse(cached);
 var lock=LockService.getScriptLock();
 if(!lock.tryLock(1000)){var previous=last_(metric);if(previous){previous.stale=true;previous.refreshError='다른 수집이 진행 중입니다.';return publicDashboard_(previous);}throw Error('다른 수집이 진행 중입니다. 잠시 후 다시 확인하세요.');}
 try{cached=cache.get(key);if(cached)return JSON.parse(cached);var d=publicDashboard_(save_(collect_(metric))),text=JSON.stringify(d);if(Utilities.newBlob(text).getBytes().length<95000)cache.put(key,text,d.status==='complete'?600:180);return d;}
 catch(e){var previous=last_(metric);if(previous){previous.stale=true;previous.refreshError=e.message;return publicDashboard_(previous);}throw e;}
 finally{lock.releaseLock();}
}
function book_(){var id=PropertiesService.getScriptProperties().getProperty('SPREADSHEET_ID');if(!id)throw Error('먼저 setup 함수를 실행하세요.');return SpreadsheetApp.openById(id);}
function number_(x){if(x===null||x===undefined||String(x).trim()==='')return null;var n=Number(String(x).replace(/,/g,'').replace('%',''));return isFinite(n)?n:null;}
function text_(r){var code=r.getResponseCode();if(code!==200)throw Error('공급자 HTTP '+code);return r.getContentText();}
function options_(url){return {url:url,muteHttpExceptions:true,followRedirects:true,headers:{Referer:'https://stock.naver.com/'}};}
function aggregate_(rows,market){var out={market:market,basis:'보통주 합산 참고값',officialIndex:false};['per','pbr'].forEach(function(k){var a=rows.filter(function(s){return number_(s[k])>0&&number_(s.marketSum)>0;}),cap=0,den=0;a.forEach(function(s){cap+=number_(s.marketSum);den+=number_(s.marketSum)/number_(s[k]);});out[k]=den>0?cap/den:null;out[k+'Count']=a.length;});return out;}
function vix_(r){var out={value:null,status:'error',source:'https://cdn.cboe.com/api/global/us_indices/daily_prices/VIX_History.csv'};try{var lines=text_(r).trim().split(/\r?\n/),today=Utilities.formatDate(new Date(),'America/New_York','yyyy-MM-dd');for(var i=lines.length-1;i>0;i--){var a=lines[i].split(','),m=a[0].match(/^(\d{1,2})\/(\d{1,2})\/(\d{4})$/);if(!m)continue;var date=m[3]+'-'+('0'+m[1]).slice(-2)+'-'+('0'+m[2]).slice(-2);if(date<=today&&number_(a[4])>0){out.value=number_(a[4]);out.asOf=date;out.status='ok';break;}}if(!out.value)throw Error('VIX 종가 없음');}catch(e){out.error=e.message;}return out;}
function sheet_(name,headers){var b=book_(),s=b.getSheetByName(name);if(!s){s=b.insertSheet(name);s.getRange(1,1,1,headers.length).setValues([headers]).setBackground('#e4ecde').setFontWeight('bold');s.setFrozenRows(1);}return s;}
function safe_(v){return typeof v==='string'&&/^[=+@]/.test(v)?"'"+v:v===undefined||v===null?'':v;}
function normalizedRow_(r,headers){return r.map(function(v,i){if(headers[i]==='코드')return ('000000'+String(v)).slice(-6);if(/기준일$/.test(headers[i])&&Object.prototype.toString.call(v)==='[object Date]')return Utilities.formatDate(v,'Asia/Seoul','yyyy-MM-dd');return v;});}
function upsert_(name,headers,incoming,keyCols){var s=sheet_(name,headers),count=Math.max(0,s.getLastRow()-1),old=count?s.getRange(2,1,count,headers.length).getValues():[],rows=[],index={};old.concat(incoming).forEach(function(r){r=normalizedRow_(r,headers);var key=keyCols.map(function(k){return r[k];}).join('|');if(index[key]!==undefined)rows[index[key]]=r;else{index[key]=rows.length;rows.push(r);}});if(rows.length){headers.forEach(function(h,i){if(h==='코드'||/기준일$/.test(h))s.getRange(2,i+1,Math.max(count,rows.length),1).setNumberFormat('@');});s.getRange(2,1,rows.length,headers.length).setValues(rows.map(function(r){return r.map(safe_);}));}if(count>rows.length)s.getRange(rows.length+2,1,count-rows.length,headers.length).clearContent();return s;}

